{
  "name": "coaching-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run lint",
    "test:stripe-subscriptions": "npx tsx scripts/stripe-subscription.test.ts",
    "setup:stripe-coaching": "node scripts/setup-stripe-coaching-production.mjs",
    "setup:stripe-connect-payment-methods": "node scripts/setup-stripe-connect-payment-methods.mjs",
    "verify:stripe-coaching": "node scripts/verify-stripe-coaching-production.mjs",
    "test:e2e": "node scripts/e2e-smoke-ci.mjs",
    "test:e2e:athlete-desktop": "node scripts/e2e-athlete-dashboard-desktop.mjs",
    "ingest:ess": "node scripts/ingest-ess-pdf.mjs",
    "export:code": "bash scripts/export-code.sh",
    "plan-r2-migration": "npx tsx scripts/plan-supabase-to-r2-migration.ts",
    "migrate-r2": "npx tsx scripts/migrate-supabase-to-r2.ts",
    "migrate-r2:execute": "npx tsx scripts/migrate-supabase-to-r2.ts --execute",
    "cap:icons": "node scripts/generate-ios-icon.mjs && npx capacitor-assets generate --ios",
    "cap:sync": "npx cap sync ios",
    "cap:open:ios": "npx cap open ios",
    "ios:sync": "npx cap sync ios",
    "ios:sync:dev": "CAP_ENV=development npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:dev": "CAP_ENV=development npx cap sync ios && bash scripts/ios-run-sim.sh",
    "ios:sim:prod": "npx cap sync ios && bash scripts/ios-run-sim.sh",
    "ios:archive": "bash scripts/ios-archive-testflight.sh",
    "ios:build": "bash scripts/ios-run-sim.sh",
    "verify:ios-release": "node scripts/verify-ios-release.mjs",
    "create:app-review-demo": "node scripts/create-app-review-demo.mjs",
    "verify:review-demo": "node scripts/verify-review-demo.mjs",
    "capture:app-store-screenshots": "node scripts/capture-app-store-screenshots.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@sentry/nextjs": "^10.62.0",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-query": "^5.101.1",
    "framer-motion": "^12.41.0",
    "heic2any": "^0.0.4",
    "jose": "^6.2.3",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "posthog-js": "^1.395.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "stripe": "^22.2.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.61.0",
    "sharp": "^0.35.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
