{
  "headers": [
    {
      "source": "/((?!_next/static|_next/image|favicon.ico|.*\\.(?:png|jpg|jpeg|gif|webp|svg|ico|woff2?)$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/competition-calendar/sync",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/broadcasts",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/storage-cleanup",
      "schedule": "0 3 * * 0"
    }
  ]
}
